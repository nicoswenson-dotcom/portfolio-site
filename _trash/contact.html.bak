<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Contact — Miss Texas 1988</title>
  <meta name="description" content="Book Miss Texas 1988 for performance, hosting, writing assignments, or design commissions." />
  <link rel="icon" type="image/png" sizes="32x32" href="assets/images/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="assets/images/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="assets/images/favicon-192.png" />
  <link rel="shortcut icon" href="assets/images/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/styles.css" />
</head>
<body>

  <header class="site-header">
    <nav class="nav" aria-label="Primary">
      <a class="nav-brand" href="index.html">Miss Texas 1988</a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">≡</button>
      <ul class="nav-links" id="primary-nav">
        <li><a href="index.html">Home</a></li>
        <li><a href="drag.html">Drag</a></li>
        <li><a href="writing.html">Writing</a></li>
        <li><a href="design.html">Design</a></li>
        <li><a href="contact.html">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="section wrap" style="padding-top: clamp(3rem, 7vw, 5rem);">
      <div class="reveal" style="max-width: 820px;">
        <span class="eyebrow">Hello hi</span>
        <h1 class="hero__title headline-rainbow" style="font-size: clamp(3rem, 8vw, 6.5rem);">
          <span class="word">Let's</span>
          <span class="word word--rotate">talk!</span>
        </h1>
        <p class="hero__lead" style="max-width: 56ch;">
          Bookings, press, freelance writing, design briefs, friendly hellos.
          Pick whichever channel feels right.
        </p>
      </div>
    </section>

    <div class="scallop scallop--yellow" aria-hidden="true"></div>

    <section class="section wrap">
      <div class="contact-grid">
        <aside class="contact-card reveal">
          <h3>Quick links</h3>
          <div class="contact-row">
            <span class="tag tag--pink">DM</span>
            <a href="https://instagram.com/misstexas1988" target="_blank" rel="noopener">@misstexas1988</a>
          </div>
          <div class="contact-row">
            <span class="tag tag--yellow">Email</span>
            <a href="mailto:misstexas1988@gmail.com">misstexas1988@gmail.com</a>
          </div>
          <div class="contact-row">
            <span class="tag tag--blue">PDF</span>
            <a href="assets/files/Miss-Texas-1988-Drag-Resume.pdf" target="_blank" rel="noopener">Press kit / drag resume</a>
          </div>
          <div class="contact-row">
            <span class="tag">📍</span>
            <span style="font-family: var(--font-display); font-size: 1.1rem;">Seattle, WA</span>
          </div>

          <p class="mt-4" style="font-family: var(--font-serif); font-style: italic;">
            "She dabbles in everything from the silly to the sublime."
          </p>
        </aside>

        <form class="form reveal" data-form="contact"
              action="https://formspree.io/f/YOUR_FORMSPREE_ID"
              method="POST">
          <div>
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" required autocomplete="name" />
          </div>

          <div>
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" required autocomplete="email" />
          </div>

          <div>
            <label for="f-type">What's this about?</label>
            <select id="f-type" name="inquiry-type" required>
              <option value="">Pick one…</option>
              <option>Booking — performance / hosting</option>
              <option>Press / interview</option>
              <option>Writing — freelance assignment</option>
              <option>Design — commission</option>
              <option>Friendly hello</option>
              <option>Other</option>
            </select>
          </div>

          <div>
            <label for="f-msg">Tell me more</label>
            <textarea id="f-msg" name="message" required placeholder="Date, venue, brief, vibe — whatever you've got."></textarea>
          </div>

          <button class="btn btn--pink" type="submit" style="justify-self: start;">Send it ✦</button>
          <p class="form__status" style="font-family: var(--font-mono); font-size: 0.85rem; min-height: 1.2em;"></p>

          <p style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-soft);">
            <strong>To activate:</strong> create a free account at
            <a href="https://formspree.io" target="_blank" rel="noopener">formspree.io</a>,
            grab your form ID, and replace <code>YOUR_FORMSPREE_ID</code> in the
            <code>action</code> attribute above. Until then, submissions will show a preview message.
          </p>
        </form>
      </div>
    </section>

    <div class="marquee marquee--blue" aria-hidden="true">
      <div class="marquee__track">
        <span>★ now booking ★</span><span>Drag · Writing · Design</span>
        <span>Seattle &amp; beyond</span>
        <span>★ now booking ★</span><span>Drag · Writing · Design</span>
        <span>Seattle &amp; beyond</span>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <img class="footer-logo" src="assets/images/mt-logo-dark.png" alt="Miss Texas 1988 logo" />
        <h4>Miss Texas 1988</h4>
        <p>Seattle-based drag artist, writer, and designer.<br/>For booking, press, or pixels — get in touch.</p>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="drag.html">Drag</a></li>
          <li><a href="writing.html">Writing</a></li>
          <li><a href="design.html">Design</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Find me</h4>
        <ul>
          <li><a href="https://instagram.com/misstexas1988" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="mailto:misstexas1988@gmail.com">Email</a></li>
          <li><a href="assets/files/Miss-Texas-1988-Drag-Resume.pdf" target="_blank" rel="noopener">Press kit (PDF)</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-fineprint">
      <span>© <span id="year"></span> Miss Texas 1988.</span>
      <span>Site stitched together with love + halftone dots.</span>
    </div>
  </footer>

  <script>document.getElementById('year').textContent = new Date().getFullYear();</script>
  <script src="js/main.js"></script>
</body>
</html>
